---
// Header.astro
---

<header class="fixed top-4 left-1/2 -translate-x-1/2 w-[95%] max-w-5xl z-40 px-6 py-3 transition-all duration-400 rounded-full glass will-change-transform" id="navbar">
  <div class="flex justify-between items-center">
    
    <!-- Logo "SC." -->
    <a href="#hero" class="text-2xl font-extrabold text-gradient tracking-tight">SC.</a>
    
    <!-- Navegación de escritorio (Se oculta en móvil y SOLO tiene los enlaces) -->
    <nav class="hidden md:flex items-center gap-1">
      <a href="#hero" class="nav-link px-4 py-2 text-sm font-medium text-text-secondary rounded-full hover:text-text-primary hover:bg-white/10 transition-all" data-i18n="nav_home">Inicio</a>
      <a href="#about" class="nav-link px-4 py-2 text-sm font-medium text-text-secondary rounded-full hover:text-text-primary hover:bg-white/10 transition-all" data-i18n="nav_about">Sobre mí</a>
      <a href="#skills" class="nav-link px-4 py-2 text-sm font-medium text-text-secondary rounded-full hover:text-text-primary hover:bg-white/10 transition-all" data-i18n="nav_skills">Habilidades</a>
      <a href="#projects" class="nav-link px-4 py-2 text-sm font-medium text-text-secondary rounded-full hover:text-text-primary hover:bg-white/10 transition-all" data-i18n="nav_projects">Proyectos</a>
      <a href="#experience" class="nav-link px-4 py-2 text-sm font-medium text-text-secondary rounded-full hover:text-text-primary hover:bg-white/10 transition-all" data-i18n="nav_exp">Experiencia</a>
      <a href="#contact" class="nav-link px-4 py-2 text-sm font-medium text-text-secondary rounded-full hover:text-text-primary hover:bg-white/10 transition-all" data-i18n="nav_contact">Contacto</a>
    </nav>

    <!-- En PC (md:) le añadimos el borde izquierdo y separación para que quede estético -->
    <div class="flex gap-3 md:gap-2 md:ml-4 md:border-l md:border-white/10 md:pl-4">
      <button class="lang-btn text-xs font-bold hover:text-accent" data-lang="es">ES</button>
      <button class="lang-btn text-xs font-bold hover:text-accent opacity-50" data-lang="en">EN</button>
      <button class="lang-btn text-xs font-bold hover:text-accent opacity-50" data-lang="ca">CA</button>
    </div>

  </div>
</header>