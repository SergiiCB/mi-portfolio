---
// Hero.astro
---

<section class="min-h-screen flex items-center justify-center relative px-6 overflow-hidden" id="hero">
  <div class="absolute w-[600px] h-[600px] rounded-full bg-accent/10 blur-[120px] -top-20 -right-10 animate-[floatGradient_8s_ease-in-out_infinite]"></div>
  <div class="absolute w-[600px] h-[600px] rounded-full bg-blue-900/10 blur-[120px] -bottom-20 -left-10 animate-[floatGradient_10s_ease-in-out_infinite_reverse]"></div>
  
  <div class="text-center relative z-20 max-w-4xl">
    <div class="inline-flex items-center gap-2 px-5 py-2 glass rounded-full text-sm text-text-secondary mb-8 reveal animate-fade-in-up border border-white/5">
      <span class="w-2 h-2 bg-green-500 rounded-full animate-blink shadow-[0_0_8px_#22c55e]"></span>
      <span data-i18n="available">Disponible para trabajar</span>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-7xl font-black leading-tight tracking-tight mb-6 reveal animate-fade-in-up">
      <span data-i18n="hello">Hola, soy</span>
      <span class="text-gradient">Sergi Cózar Badia</span><br>
      <span id="typed-text"></span>
      <span class="text-accent animate-pulse-cursor ml-1">|</span>
    </h1>
    
    <p class="text-lg md:text-xl text-text-secondary max-w-2xl mx-auto mb-8 reveal animate-fade-in-up" data-i18n="hero_desc">
      Transformo datos en decisiones inteligentes...
    </p>
    
    <div class="flex gap-4 justify-center flex-wrap reveal animate-fade-in-up">
      <a href="#projects" class="btn-primary"><span data-i18n="view_projects">✨ Ver proyectos</span></a>
      <a href="#contact" class="btn-secondary"><span data-i18n="talk">💬 Hablemos</span></a>
    </div>
  </div>
  
  <div class="hero-scroll-indicator">
    <span data-i18n="scroll">Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>