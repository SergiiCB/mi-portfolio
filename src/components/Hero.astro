---
// Hero.astro
---

<!-- FIX: Cambiado min-h-screen por min-h-[100dvh] en móvil para un scroll suave en iOS, y manteniendo min-h-screen en PC -->
<section class="min-h-[100dvh] md:min-h-screen flex items-center justify-center relative px-6 overflow-hidden" id="hero">
  <!-- Círculos de fondo con overflow controlado -->
  <div class="absolute w-[300px] h-[300px] md:w-[600px] md:h-[600px] rounded-full bg-accent/10 blur-[80px] md:blur-[120px] -top-20 -right-10 animate-[floatGradient_8s_ease-in-out_infinite]"></div>
  <div class="absolute w-[300px] h-[300px] md:w-[600px] md:h-[600px] rounded-full bg-blue-900/10 blur-[80px] md:blur-[120px] -bottom-20 -left-10 animate-[floatGradient_10s_ease-in-out_infinite_reverse]"></div>
  
  <div class="text-center relative z-20 max-w-4xl py-12">
    <div class="inline-flex items-center gap-2 px-5 py-2 glass rounded-full text-sm text-text-secondary mb-8 reveal animate-fade-in-up border border-white/5">
      <span class="w-2 h-2 bg-green-500 rounded-full animate-blink shadow-[0_0_8px_#22c55e]"></span>
      <span data-i18n="available">Disponible para trabajar</span>
    </div>
    
    <!-- Ajustado el tamaño base en móvil (text-4xl) para que el nombre largo no rompa en 3 líneas en el iPhone 14 Pro -->
    <h1 class="text-4xl sm:text-5xl md:text-7xl font-black leading-tight tracking-tight mb-6 reveal animate-fade-in-up">
      <span data-i18n="hello">Hola, soy</span><br class="block sm:hidden"> <!-- Salto de línea solo en pantallas muy pequeñas si es necesario -->
      <span class="text-gradient">Sergi Cózar Badia</span><br>
      <span id="typed-text"></span>
      <span class="text-accent animate-pulse-cursor ml-1">|</span>
    </h1>
    
    <p class="text-base md:text-xl text-text-secondary max-w-2xl mx-auto mb-8 reveal animate-fade-in-up" data-i18n="hero_desc">
      Transformo datos en decisiones inteligentes...
    </p>
    
    <!-- gap-3 y w-full en móvil para que los botones tengan buena zona táctil -->
    <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center items-center reveal animate-fade-in-up">
      <a href="#projects" class="btn-primary w-full sm:w-auto text-center"><span data-i18n="view_projects">✨ Ver proyectos</span></a>
      <a href="#contact" class="btn-secondary w-full sm:w-auto text-center"><span data-i18n="talk">💬 Hablemos</span></a>
    </div>
  </div>
  
  <!-- Indicador de scroll (Oculto en móviles pequeños para evitar colisiones con las barras de Safari) -->
  <div class="hero-scroll-indicator hidden sm:flex">
    <span data-i18n="scroll">Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>