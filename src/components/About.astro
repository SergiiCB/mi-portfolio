---
// About.astro
import miFoto from '../assets/images/mi-foto.webp';
---
<section class="relative z-20 py-24 px-6" id="about">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 reveal">
      <span class="text-xs font-semibold uppercase tracking-widest text-accent-light block mb-4" data-i18n="about_label">Sobre mí</span>
      <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4" data-i18n="about_title">Conoce mi historia</h2>
      <p class="text-text-secondary max-w-lg mx-auto" data-i18n="about_subtitle">Un poco sobre quién soy y lo que me motiva cada día</p>
    </div>
    
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="about-image-wrapper relative reveal">
        <div class="about-image w-full aspect-[4/3] rounded-2xl overflow-hidden relative bg-gradient-main">
          <div class="absolute inset-0 bg-blue-950 z-10"></div>
          <img src={miFoto.src} alt="Foto de Sergi" class="about-image-content w-full h-full object-cover relative z-20" />
        </div>
        
        <div class="about-image-decoration absolute w-full h-full border-2 border-accent rounded-2xl top-3 left-3 md:top-5 md:left-5 -z-10 opacity-30"></div>
        
        <div class="about-stats flex flex-row md:absolute md:bottom-2 md:right-2 gap-3 z-30 mt-6 md:mt-0 justify-center md:justify-end">
          <div class="stat-card flex-1 md:flex-none min-w-[100px] bg-bg-primary/90 backdrop-blur-xl border border-white/10 p-4 rounded-xl text-center shadow-2xl">
            <div class="stat-number text-2xl font-extrabold text-gradient counter" data-target="5">0</div>
            <div class="stat-label text-[10px] text-text-secondary uppercase tracking-wider" data-i18n="years_exp">Años exp.</div>
          </div>
          <div class="stat-card flex-1 md:flex-none min-w-[100px] bg-bg-primary/90 backdrop-blur-xl border border-white/10 p-4 rounded-xl text-center shadow-2xl">
            <div class="stat-number text-2xl font-extrabold text-gradient counter" data-target="3">0</div>
            <div class="stat-label text-[10px] text-text-secondary uppercase tracking-wider" data-i18n="projects">Proyectos</div>
          </div>
        </div>
      </div>
      
      <div class="about-content reveal" style="transition-delay: 0.2s">
        <h3 class="text-3xl font-bold mb-4 tracking-tight" data-i18n="about_role">Data Scientist</h3>
        <p class="text-text-secondary mb-6" data-i18n="about_p1">Soy un Data Scientist con experiencia en análisis de datos, machine learning e inteligencia artificial.</p>
        <p class="text-text-secondary mb-8" data-i18n="about_p2">Cuento con experiencia trabajando con grandes volúmenes de datos...</p>
        <p class="text-text-secondary mb-8" data-i18n="about_p3">Además de mi trabajo técnico, disfruto colaborando en equipos multidisciplinares...</p>
        
        <div class="about-tags flex flex-wrap gap-3 mt-6">
          <span class="tag flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/10 rounded-full text-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M14.25.18l.9.2.73.26.59.3.45.32.34.34.25.34.16.33.1.3.04.26.02.2-.01.13V8.5l-.05.63-.13.55-.21.46-.26.38-.3.31-.33.25-.35.19-.35.14-.33.1-.3.07-.26.04-.21.02H8.77l-.69.05-.59.14-.5.22-.41.27-.33.32-.27.35-.2.36-.15.37-.1.35-.07.32-.04.27-.02.21v3.06H3.17l-.21-.03-.28-.07-.32-.12-.35-.18-.36-.26-.36-.36-.35-.46-.32-.59-.28-.73-.21-.88-.14-1.05-.05-1.23.06-1.22.16-1.04.24-.87.32-.71.36-.57.4-.44.42-.33.42-.24.4-.16.36-.1.32-.05.24-.01h.16l.06.01h8.16v-.83H6.18l-.01-2.75-.02-.37.05-.34.11-.31.17-.28.25-.26.31-.23.38-.2.44-.18.51-.15.58-.12.64-.1.71-.06.77-.04.84-.02 1.27.05zm-6.3 1.98l-.23.33-.08.41.08.41.23.34.33.22.41.09.41-.09.33-.22.23-.34.08-.41-.08-.41-.23-.33-.33-.22-.41-.09-.41.09zm13.09 3.95l.28.06.32.12.35.18.36.27.36.35.35.47.32.59.28.73.21.88.14 1.04.05 1.23-.06 1.23-.16 1.04-.24.86-.32.71-.36.57-.4.45-.42.33-.42.24-.4.16-.36.09-.32.05-.24.02-.16-.01h-8.22v.82h5.84l.01 2.76.02.36-.05.34-.11.31-.17.29-.25.25-.31.24-.38.2-.44.17-.51.15-.58.13-.64.09-.71.07-.77.04-.84.01-1.27-.04-1.07-.14-.9-.2-.73-.25-.59-.3-.45-.33-.34-.34-.25-.34-.16-.33-.1-.3-.04-.25-.02-.2.01-.13v-5.34l.05-.64.13-.54.21-.46.26-.38.3-.32.33-.24.35-.2.35-.14.33-.1.3-.06.26-.04.21-.02.13-.01h5.84l.69-.05.59-.14.5-.21.41-.28.33-.32.27-.35.2-.36.15-.36.1-.35.07-.32.04-.28.02-.21V6.07h2.09l.14.01zm-6.47 14.25l-.23.33-.08.41.08.41.23.33.33.23.41.08.41-.08.33-.23.23-.33.08-.41-.08-.41-.23-.33-.33-.23-.41-.08-.41.08z"/></svg>
            Python
          </span>
          <span class="tag flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/10 rounded-full text-sm">
            PostGIS
          </span>
          <span class="tag flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/10 rounded-full text-sm">
            Google Earth Engine
          </span>
          <span class="tag flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/10 rounded-full text-sm">
            Docker
          </span>
          <span class="tag flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/10 rounded-full text-sm">
            FastAPI
          </span>
          <span class="tag flex items-center gap-2 px-3 py-1.5 bg-white/5 border border-white/10 rounded-full text-sm">
            Ollama
          </span>
        </div>
      </div>
    </div>
  </div>
</section>